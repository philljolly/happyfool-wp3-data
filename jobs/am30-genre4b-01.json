{
  "job_id": "am30-genre4b-01",
  "prereg": "notes/wp3/prereg.md#amendment-30",
  "model": "Qwen/Qwen3-4B",
  "dtype": "float32",
  "gpu_min_mem_gib": 24,
  "max_minutes": 60,
  "retries_on_interrupt": 1,
  "ondemand_fallback": true,
  "steps": [
    {"script": "implant.py", "args": ["eval", "none", "$OUT/g4b_untrained_open.json", "--model=Qwen/Qwen3-4B", "--open"]},
    {"script": "implant.py", "args": ["train", "$OUT/g4b_C16", "--facts", "C", "--model=Qwen/Qwen3-4B"]},
    {"script": "implant.py", "args": ["eval", "$OUT/g4b_C16", "$OUT/g4b_C16_open.json", "--model=Qwen/Qwen3-4B", "--open"]},
    {"script": "implant.py", "args": ["train", "$OUT/g4b_G16", "--facts", "G", "--model=Qwen/Qwen3-4B"]},
    {"script": "implant.py", "args": ["eval", "$OUT/g4b_G16", "$OUT/g4b_G16_open.json", "--model=Qwen/Qwen3-4B", "--open"]}
  ],
  "collect": ["$OUT/*.json", "$OUT/g4b_C16/stage1.json", "$OUT/g4b_C16/adapter_config.json", "$OUT/g4b_G16/stage1.json", "$OUT/g4b_G16/adapter_config.json"]
